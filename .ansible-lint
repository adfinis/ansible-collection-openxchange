---

skip_list:
  - meta-runtime[unsupported-version]
  - galaxy[version-incorrect]
  - galaxy[no-changelog]
  - schema[meta-runtime]
  - name[casing]
  - yaml[comments-indentation]
  - var-naming[no-role-prefix]

exclude_paths:
  - .cache/  # implicit unless exclude_paths is defined in config
  - .github/
